# Database (Neon Serverless PostgreSQL)
# Vercel Marketplace の Neon 統合で自動設定される
# ローカル開発時は `vercel env pull .env.local` で取得
DATABASE_URL=

# NextAuth.js
AUTH_SECRET=                    # openssl rand -base64 32 で生成

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# App URL (本番: https://signalog.vercel.app)
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (レートリミット用・未設定時はスキップ)
# https://console.upstash.com/ でRedisを作成して取得
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (Phase 2: オプション)
# NEXT_PUBLIC_SENTRY_DSN=

# Plausible Analytics (Phase 1: オプション)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Upstash Redis (Phase 2: レートリミット用)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Anthropic (Phase 2: AI要約用)
# ANTHROPIC_API_KEY=
